# Only real image files may be served from this folder.
# Everything else (php, html, svg, pdf, exe, zip, ...) is denied.

Options -Indexes -ExecCGI

<FilesMatch "\.(?i:php|phtml|php3|php4|php5|php7|php8|phps|phar|pl|py|cgi|asp|aspx|jsp|jspx|sh|exe|dll|bat|cmd|com|msi|js|mjs|html?|htm|svg|xml|pdf|zip|rar|7z|tar|gz)$">
  Require all denied
</FilesMatch>

<FilesMatch "\.(?i:jpe?g|png|webp)$">
  Require all granted
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Content-Disposition "inline"
</IfModule>
