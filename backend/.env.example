APP_NAME="NJV School Voting"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Production values (https://vote.zeeshanfarooq.site)
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://vote.zeeshanfarooq.site
# SESSION_SECURE_COOKIE=true
# SANCTUM_STATEFUL_DOMAINS=vote.zeeshanfarooq.site

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development (MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zeesyswc_voting
DB_USERNAME=root
DB_PASSWORD=

# Production (Namecheap cPanel MySQL) — use the cPanel database user, never root
# DB_HOST=localhost
# DB_DATABASE=zeesyswc_voting
# DB_USERNAME=zeesyswc_njvvoting
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=database

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173,127.0.0.1:8000

MAIL_MAILER=log
MAIL_FROM_ADDRESS="olivia.t@example.org"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
